#!/usr/bin/env bash
# Nixi launcher — starts the local server (if needed) and pops the little guy up.
#   nixi-companion            show / hide him (bind this to a hotkey)
#   nixi-companion listen     pop up and start listening right away (great on a hotkey)
#   nixi-companion look       take a screenshot, then listen ("what's this error?")
#   nixi-companion see [screen]  print a picture of your window (or whole screen) — Claude uses this to look when it needs to
#   nixi-companion live       live view on/off: he sees your screen with everything you say, until you turn it off
#   nixi-companion hover      toggle hover mode (he floats next to your mouse)
#   nixi-companion ptt-down / nixi-companion ptt-up   push-to-talk: bind to a key's press and release (Hyprland: bind / bindr)
#   nixi-companion show|hide|quit
#   nixi-companion doctor     check mic, voice and Claude Code
#   nixi-companion diagnostics  a report to paste when asking for help (nothing is sent)
#   nixi-companion stress     test his voice for stutters under heavy load
#   nixi-companion render default|nodmabuf|nocomp   how the window is drawn (nocomp is steadiest on NVIDIA)
#   nixi-companion server     run the server in the foreground (for debugging)
#   nixi-companion stop       stop the background server (and the window)
#   nixi-companion restart    restart the server (after editing config)
#   nixi-companion log        follow the server log
#   nixi-companion setup      first run after a system-wide install (ninja install): your voice + speech models
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/nixi-companion"; mkdir -p "$ROOT"   # first run under Nix: nothing else creates it
# the app lives in your home folder (./install.sh) or next to this launcher (system-wide: /usr/bin → /usr/share/nixi-companion)
SHARE="$(cd "$(dirname "$(readlink -f "$0")")/../share/nixi-companion" 2>/dev/null && pwd || true)"
if [ -d "$ROOT/app" ] || [ -z "$SHARE" ] || [ ! -d "$SHARE/app" ]; then APP="$ROOT/app"; else APP="$SHARE/app"; fi
PY="$ROOT/venv/bin/python"; LOG="$ROOT/server.log"
if [ -n "${NIXI_COMPANION_APP:-}" ] && [ -n "${NIXI_COMPANION_PYTHON:-}" ]; then APP="$NIXI_COMPANION_APP"; PY="$NIXI_COMPANION_PYTHON"; fi
# an agent's hook says it needs you: tell the running companion, never start it, never fail (hooks must not break an agent)
#   nixi-companion attention --from claude [message words…]
if [ "${1:-}" = attention ]; then shift; FROM=agent
  [ "${1:-}" = --from ] && { FROM="${2:-agent}"; shift 2 || shift; }
  "${NIXI_COMPANION_PYTHON:-python3}" -c 'import json,sys,os,urllib.request as u
try:
    rt = json.load(open(os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "nixi-companion", "runtime.json")))
    u.urlopen(u.Request("http://127.0.0.1:%s/api/attention" % rt["port"], json.dumps({"from": sys.argv[1], "text": " ".join(sys.argv[2:])}).encode(),
              {"Content-Type": "application/json", "X-Nixi-Token": rt["token"]}), timeout=3).read()
except Exception:
    pass' "$FROM" "$@" >/dev/null 2>&1
  exit 0
fi
# push-to-talk from a desktop key binding (one call on press, one on release): straight to the running window, fast
case "${1:-}" in ptt-down|ptt-up)
  PSOCK="${XDG_RUNTIME_DIR:-/tmp}/nixi-companion-$(id -u).sock"
  if [ -S "$PSOCK" ] && "${NIXI_COMPANION_PYTHON:-python3}" -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall(sys.argv[2].encode())' "$PSOCK" "$1" 2>/dev/null; then exit 0; fi
  [ "$1" = ptt-up ] && exit 0
  set -- listen ;;                                     # he isn't open yet: start him and just listen
esac
if [ "${1:-}" = setup ]; then
  if [ -n "${NIXI_COMPANION_APP:-}" ] && [ -n "${NIXI_COMPANION_PYTHON:-}" ]; then echo "installed by Nix; nothing to set up"; exit 0; fi
  [ -x "${SHARE:-}/install.sh" ] && exec "$SHARE/install.sh" --user
  echo "nixi-companion setup is for system-wide installs — run ./install.sh from the folder you downloaded instead" >&2; exit 1
fi
if { [ -z "${NIXI_COMPANION_APP:-}" ] || [ -z "${NIXI_COMPANION_PYTHON:-}" ]; } && [ ! -x "$PY" ]; then
  if [ "$APP" = "${SHARE:-}/app" ]; then echo "First time? Run:  nixi-companion setup   (downloads your voice + speech models)" >&2
  else echo "Nixi isn't installed — run install.sh" >&2; fi
  exit 1
fi
PORT="$("$PY" "$APP/server.py" --print-port)"
URL="http://127.0.0.1:$PORT/"
up(){ curl -fs -o /dev/null "${URL}api/state"; }
stop(){ pkill -f "$APP/server.py" >/dev/null 2>&1 || true; }

# the old browser-window fallback (a normal app window) — always clean it up so it can't linger looking like Nixi
killbrowser(){ pkill -f -- "--user-data-dir=$ROOT/browser" >/dev/null 2>&1 || true; }
quitwin(){ pkill -f "$APP/window.py" >/dev/null 2>&1 || true; killbrowser
  command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && { [ "$(hyprctl keyword cursor:invisible false 2>&1)" = ok ] || hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1; } || true; }

case "${1:-}" in
  theme-changed) up 2>/dev/null && "$PY" "$APP/server.py" --theme-changed || true; exit 0 ;;   # the omarchy theme hook: recolour the running Nixi
  stop)    stop; quitwin; echo "Nixi stopped"; exit 0 ;;
  stress)  exec "$PY" "$APP/server.py" --stress-voice "${@:2}" ;;
  diagnostics) exec "$PY" "$APP/server.py" --diagnostics ;;
  see)     exec "$PY" "$APP/server.py" --see "${2:-window}" ;;            # view-only picture of your screen (for Claude)     # speak under heavy load, report any stutter
  doctor)  echo "── window ──"
           for c in "${NIXI_COMPANION_PYTHON:-}" /usr/bin/python3 /usr/bin/python; do [ -x "$c" ] && { "$c" "$APP/window.py" --check 2>&1 | tail -n 3 || echo "overlay: window can't start (pacman -S python-gobject webkit2gtk-4.1 gtk-layer-shell)"; break; }; done
           echo "env: WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} GDK_BACKEND=${GDK_BACKEND:-unset} XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset}"
           pgrep -f "$APP/window.py" >/dev/null && echo "running: overlay window process" || echo "running: no window process"
           pgrep -f -- "--user-data-dir=$ROOT/browser" >/dev/null && echo "running: a BROWSER window (the old fallback — 'nixi-companion stop' closes it)"
           [ -f "$LOG" ] && { echo "last window notes:"; grep -E "overlay:|window:|window died|renderer" "$LOG" | tail -n 6 | sed 's/^/  /'; }
           echo "── voice & mic ──"
           exec "$PY" "$APP/server.py" --doctor ;;
  restart) stop; sleep 0.6 ;;
  log)     exec tail -n 50 -f "$LOG" ;;
  render)  # pick how the window is drawn: default (GPU) · nodmabuf · nocomp (no GPU layers — steadiest)
           case "${2:-}" in default|nodmabuf|nocomp) echo "$2" > "$ROOT/window.mode"; quitwin; sleep 0.4; exec "$0" show ;;
             *) echo "usage: nixi-companion render default|nodmabuf|nocomp   (now: $(cat "$ROOT/window.mode" 2>/dev/null || echo auto))"; exit 2 ;; esac ;;
  server)  exec "$PY" "$APP/server.py" ;;
esac

if ! up; then
  setsid -f "$PY" "$APP/server.py" >>"$LOG" 2>&1 </dev/null
  for _ in $(seq 60); do up && break; sleep 0.1; done
  up || { echo "server didn't start — see $LOG" >&2; exit 1; }
fi

CMD="${1:-toggle}"
case "$CMD" in toggle|show|hide|quit|restart|listen|look|live|hover|hover-on|hover-off) ;;
  *) echo "usage: nixi-companion [listen|look|live|hover|show|hide|quit|doctor|diagnostics|stress|render|stop|restart|log|server]" >&2; exit 2 ;; esac
[ "$CMD" = restart ] && CMD=show
FIRST="$CMD"; [ "$FIRST" = toggle ] && FIRST=show

# Preferred: a native see-through window that's just the little guy (system python + GTK + WebKit).
SOCK="${XDG_RUNTIME_DIR:-/tmp}/nixi-companion-$(id -u).sock"
winalive(){ pgrep -f "$APP/window.py" >/dev/null 2>&1; }
# On Hyprland, apply the window rules ourselves: floating, pinned, no border / shadow / blur / rounding.
# (Rule syntax changed across Hyprland versions — try old and new spellings, keep whichever is accepted.)
hypr_rules(){
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null 2>&1 || return 0
  local cls out ok r old new
  for cls in Nixi; do
    for r in "float|float on" "pin|pin on" "noborder|border_size 0" "noshadow|no_shadow on" "noblur|no_blur on" "norounding|rounding 0" "noanim|no_anim on"; do
      old="${r%%|*}"; new="${r#*|}"; ok=0
      for try in "windowrule|$old, class:^($cls)\$" "windowrulev2|$old, class:^($cls)\$" "windowrule|match:class ^($cls)\$, $new"; do
        out="$(hyprctl keyword "${try%%|*}" "${try#*|}" 2>&1 || true)"
        [ "$out" = ok ] && { ok=1; break; }
      done
      [ "$ok" = 1 ] || echo "[nixi] hyprland rule '$old' for $cls not accepted: $out" >>"$LOG"
    done
  done
}
if [ "${NIXI_COMPANION_BROWSER:-0}" != 1 ]; then
  SP="${NIXI_COMPANION_PYTHON:-}"
  if [ -z "$SP" ]; then
    for c in /usr/bin/python3 /usr/bin/python; do
      if [ -x "$c" ] && "$c" -c "import gi; gi.require_version('Gtk','3.0'); gi.require_version('WebKit2','4.1'); from gi.repository import WebKit2" >/dev/null 2>&1; then SP="$c"; break; fi
    done
  fi
  if [ -n "$SP" ]; then
    # already running → just send it show/hide/toggle
    if winalive && [ -S "$SOCK" ]; then exec "$SP" "$APP/window.py" "${URL}?native=1" "$CMD"; fi
    [ "$CMD" = hide ] || [ "$CMD" = quit ] && exit 0
    killbrowser
    hypr_rules
    # WebKitGTK + some GPU drivers (NVIDIA on Wayland especially) crash on first paint.
    # Try render modes from fastest to safest; remember the first one that stays up.
    modes="default nodmabuf nocomp"
    [ -e /proc/driver/nvidia/version ] && modes="nodmabuf nocomp"
    saved="$(cat "$ROOT/window.mode" 2>/dev/null || true)"
    [ -n "$saved" ] && modes="$saved $modes"
    for MODE in $modes; do
      env=()
      case "$MODE" in
        nodmabuf) env=(WEBKIT_DISABLE_DMABUF_RENDERER=1) ;;
        nocomp)   env=(WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1) ;;
      esac
      echo "[nixi] window: starting (render mode: $MODE)" >>"$LOG"
      env "${env[@]}" setsid -f "$SP" "$APP/window.py" "${URL}?native=1" "$FIRST" >>"$LOG" 2>&1 </dev/null
      for _ in $(seq 25); do sleep 0.1; done
      if winalive; then echo "$MODE" > "$ROOT/window.mode"; exit 0; fi
      echo "[nixi] window died in mode $MODE" >>"$LOG"
    done
    rm -f "$ROOT/window.mode"
    msg="his overlay window keeps crashing — run 'nixi-companion doctor' and 'nixi-companion log' (or try: nixi-companion render nocomp)"
  else
    msg="the overlay window needs: sudo pacman -S python-gobject webkit2gtk-4.1 gtk-layer-shell"
  fi
  echo "Nixi: $msg" >&2
  echo "      (to use a plain browser window instead: NIXI_COMPANION_BROWSER=1 nixi-companion)" >&2
  command -v notify-send >/dev/null && notify-send -a Nixi "Nixi couldn't start" "$msg" || true
  exit 1
fi
[ "$CMD" = hide ] || [ "$CMD" = quit ] && exit 0

B=""
for c in chromium google-chrome-stable google-chrome brave brave-browser vivaldi-stable microsoft-edge-stable thorium-browser; do
  command -v "$c" >/dev/null 2>&1 && { B="$c"; break; }
done
# the page never contains the server's token: hand the browser a one-time ticket (60 s, single use) to trade for it
TICKET="$("$PY" - "$ROOT/runtime.json" "$PORT" <<'PY' 2>/dev/null || true
import json, sys, urllib.request
rt = json.load(open(sys.argv[1]))
req = urllib.request.Request(f"http://127.0.0.1:{sys.argv[2]}/api/ticket", data=b"{}",
                             headers={"Content-Type": "application/json", "X-Nixi-Token": rt["token"]})
print(json.load(urllib.request.urlopen(req, timeout=5))["ticket"])
PY
)"
PAGE="${URL}#ticket=${TICKET}"
if [ -z "$B" ]; then exec xdg-open "$PAGE"; fi

# Browser fallback: dedicated profile + app window. (No mic flags needed — the server records the mic itself.)
setsid -f "$B" --app="$PAGE" --class=Nixi --name=Nixi \
  --user-data-dir="$ROOT/browser" --window-size=340,460 \
  --ozone-platform-hint=auto --autoplay-policy=no-user-gesture-required \
  --no-first-run --no-default-browser-check \
  >/dev/null 2>&1 </dev/null
