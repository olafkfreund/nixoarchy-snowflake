#!/usr/bin/env python3
"""Nix status: one live `gauges` stage on stdout. The sandbox shows it nothing of the system: Nixi passes system_status on stdin (reads: system-status, peer-status); no network."""
import json
import os
import re
import sys
import time


def num(x):
    return x if type(x) in (int, float) and x == x and abs(x) != float("inf") and x >= 0 else None


def human(n, rate=False):
    for unit in ("B", "KB", "MB", "GB", "TB", "PB") if rate else ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
        if round(n, 1) < 1024 or unit[0] == "P":
            return f"{n:.1f}".rstrip("0").rstrip(".") + (" " + unit + "/s" if rate else " " + unit)
        n /= 1024


def used_meter(label, total, used):
    total, used = num(total), num(used)
    if not total or used is None:
        return {"label": label, "pct": None, "text": "unavailable"}
    return {"label": label, "pct": round(min(100.0, used * 100 / total), 1), "text": f"{human(used)} / {human(total)}"[:40]}


def rate_meter(label, bps):
    bps = num(bps)
    return {"label": label, "pct": None, "text": "unavailable"} if bps is None else {"label": label, "pct": None, "v": bps, "text": human(bps, True)}


try:
    feed = json.load(sys.stdin)
except ValueError:
    feed = {}
feed = feed if isinstance(feed, dict) else {}
ss = feed.get("system_status") or {}
if not isinstance(ss, dict):
    ss = {}
disks = ss.get("disks") if isinstance(ss.get("disks"), list) else None
disk = {d.get("path"): d for d in disks or [] if isinstance(d, dict)}
if disks is None:                                   # an older Nixi sends no disks: read the store ourselves
    try:
        fs = os.statvfs("/nix/store")
        disk["/nix/store"] = {"total": fs.f_blocks * fs.f_frsize, "used": (fs.f_blocks - fs.f_bfree) * fs.f_frsize}
    except OSError:
        pass


def meters_of(ss, disk, with_net=True):
    mem = ss.get("mem") if isinstance(ss.get("mem"), dict) else {}
    tot, avail = num(mem.get("total")), num(mem.get("available"))
    net = ss.get("net") if isinstance(ss.get("net"), dict) else {}
    cpu = num(ss.get("cpu_pct"))
    ms = [{"label": "CPU", "pct": None if cpu is None else min(100.0, cpu), "text": "" if cpu is not None else "unavailable"},
          used_meter("MEM", tot, None if tot is None or avail is None else tot - avail),
          used_meter("/", (disk.get("/") or {}).get("total"), (disk.get("/") or {}).get("used")),
          used_meter("STORE", (disk.get("/nix/store") or {}).get("total"), (disk.get("/nix/store") or {}).get("used"))]
    if with_net:
        ms += [rate_meter("NET ↓", net.get("rx_bps")), rate_meter("NET ↑", net.get("tx_bps"))]
    ms[0] = {k: v for k, v in ms[0].items() if v != ""}
    return ms


def uptime(up):
    d, h, m = int(up // 86400), int(up % 86400 // 3600), int(up % 3600 // 60)
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"


def rev7(r):
    return r[:7] + " dirty" if r.endswith("-dirty") else r[:7]


def rev_badge(r, mine):
    if not r or not mine:
        return {"k": "rev", "v": "—"}
    return {"k": "rev", "v": rev7(r)} if r == mine else {"k": "rev", "v": "≠ " + rev7(r), "tone": "warn"}


def built_badge(b):
    return {"k": "built", "v": b[:10] if isinstance(b, str) and re.match(r"\d{4}-\d\d-\d\d(T|$)", b) else "—"}   # system_status gives full ISO 8601


meters = meters_of(ss, disk)
gen, up = ss.get("generation"), num(ss.get("uptime_s"))
badges = [{"k": "gen", "v": gen.split("-", 1)[-1][:60] if isinstance(gen, str) and gen else "unknown"}]
if up is not None:
    badges.append({"k": "up", "v": uptime(up)})
my_rev = ss.get("rev") if isinstance(ss.get("rev"), str) and ss.get("rev") else None
badges += [{"k": "rev", "v": rev7(my_rev) if my_rev else "—"}, built_badge(ss.get("built"))]
fu, fs_ = ss.get("failed"), ss.get("failed_system")
lists_ok = isinstance(fu, list) and isinstance(fs_, list)
units = [str(x)[:80] for q in (fu, fs_) if isinstance(q, list) for x in q]
if fu is None and fs_ is None:
    flist, say = {"title": "Failed", "items": ["unavailable"], "tone": "warn"}, "I couldn't check the services."
elif not lists_ok:
    flist, say = ({"title": "Failed", "items": units[:5] or ["not all checked"], "tone": "bad" if units else "warn"},
                  (f"{len(units)} failed services." if len(units) > 1 else "One failed service: " + units[0] + ".") + " I couldn't check all of them." if units else "I couldn't check all the services.")
elif units:
    flist, say = {"title": "Failed", "items": units[:5], "tone": "bad"}, f"One failed service: {units[0][:60]}." if len(units) == 1 else f"{len(units)} failed services."
else:
    flist, say = {"title": "Failed", "items": ["none"], "tone": "ok"}, "All fine."
if meters[1]["pct"] is not None and meters[1]["pct"] >= 90:
    say += " Memory is high."
host = ss.get("host") if isinstance(ss.get("host"), str) and re.fullmatch(r"[A-Za-z0-9._-]{1,32}", ss["host"]) else "this-computer"
hosts = [{"name": host, "state": "up", "badges": badges, "meters": meters, "lists": [flist]}]
peers = feed.get("peers") if isinstance(feed.get("peers"), list) else []
if peers:
    probs = [x for x in re.split(r"(?<=\.) (?=[A-Z])", say) if x != "All fine."]
    anyup = False
    for p in peers[:5]:
        if not isinstance(p, dict) or not isinstance(p.get("name"), str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,32}", p["name"]):
            continue
        n, st, ps = p["name"], p.get("state"), p.get("status")
        if st == "up" and isinstance(ps, dict):
            anyup = True
            pd = ps.get("disks") if isinstance(ps.get("disks"), list) else []
            pdisk = {d.get("path"): d for d in pd if isinstance(d, dict)}
            pup = num(ps.get("uptime_s"))
            prev = ps.get("rev") if isinstance(ps.get("rev"), str) and ps.get("rev") else None
            pb = [rev_badge(prev, my_rev), built_badge(ps.get("built"))]
            pb += [{"k": "up", "v": uptime(pup)}] if pup is not None else []
            pb.append({"k": "user", "v": "—"})
            fl = ps.get("failed_system")
            fl = [str(x)[:80] for x in fl] if isinstance(fl, list) else []
            hosts.append({"name": n, "state": "up", "badges": pb, "meters": meters_of(ps, pdisk, False),
                          "lists": [{"title": "Failed (system)", "items": fl[:5], "tone": "bad"} if fl else {"title": "Failed (system)", "items": ["none"], "tone": "ok"}]})
            if fl:
                probs.append(f"{n} has one failed service." if len(fl) == 1 else f"{n} has {len(fl)} failed services.")
            if prev and my_rev and prev != my_rev:
                probs.append(f"{n} is on another revision.")
        elif st == "asking":
            hosts.append({"name": n, "state": "stale", "badges": [{"k": "state", "v": "asking…"}]})
        else:
            lo = num(p.get("last_ok"))
            hosts.append({"name": n, "state": "down", "badges": [{"k": "last", "v": time.strftime("%H:%M", time.localtime(lo)) if lo is not None else "not seen yet"}]})
            probs.append(f"{n} is off.")
    if anyup or len(hosts) > 1:
        if not probs:
            say = "All machines look fine." if anyup else say
        else:
            say = " ".join(probs)
            k = len(probs)
            while len(say) > 200:
                k -= 1
                say = " ".join(probs[:k] + [f"and {len(probs) - k} more."])
print(json.dumps({"v": 1, "kind": "gauges", "title": "Nix status", "say": say, "source": "this computer", "live": True, "hosts": hosts}))
