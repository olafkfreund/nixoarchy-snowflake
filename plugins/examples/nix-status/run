#!/usr/bin/env python3
"""Nix status: one `facts` stage on stdout. The sandbox shows it nothing of the system: Nixi passes system_status on stdin (reads: system-status); no network."""
import json
import os
import sys


def human(n):
    for unit in "BKMGTPE":
        if round(n, 1) < 1024 or unit == "E":
            return f"{n:.1f}".rstrip("0").rstrip(".") + unit
        n /= 1024

try:
    ss = json.load(sys.stdin).get("system_status") or {}
except ValueError:
    ss = {}
pts = []
gen, failed = ss.get("generation"), ss.get("failed")
pts.append("System: " + (gen.split("-", 1)[-1][:100] if isinstance(gen, str) and gen else "unknown"))
if isinstance(failed, list):
    failed = [str(x) for x in failed]
    pts.append("Failed user services: " + (", ".join(failed[:3])[:90] + (" …" if len(failed) > 3 else "") if failed else "none"))
else:
    pts.append("Failed user services: unavailable")
try:
    fs = os.statvfs("/nix/store")
    pts.append(f"Store: {human((fs.f_blocks - fs.f_bfree) * fs.f_frsize)} used of {human(fs.f_blocks * fs.f_frsize)}")
except OSError:
    pts.append("Store: couldn't check")
print(json.dumps({"v": 1, "kind": "facts", "title": "Nix status", "points": pts, "source": "this computer"}))
